CONFIG_ARM_MPU=y
CONFIG_HW_STACK_PROTECTION=y
CONFIG_GPIO=y
# Kein UART-Pin auf V1 herausgefuehrt (PINOUT_V1) -> keine serielle Konsole
CONFIG_SERIAL=n
CONFIG_CONSOLE=n
CONFIG_UART_CONSOLE=n
# Adafruit nRF52 Bootloader (UF2), App ab 0x26000 (nrf52840_partition_uf2_sdv6.dtsi)
CONFIG_BUILD_OUTPUT_UF2=y
CONFIG_BUILD_OUTPUT_HEX=y
CONFIG_USE_DT_CODE_PARTITION=y
